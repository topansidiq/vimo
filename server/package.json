{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": "index.js",
  "pkg": {
    "assets": [
      "database/**/*",
      "routes/**/*",
      "middleware/**/*",
      "config/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "setup:linux": "bash ./scripts/install-linux.sh",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "build": "vite build",
    "pkg": "pkg . --target node18-win-x64 --public --public-packages \"*\" --output ../vimo-server.exe",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "body-parser": "^2.2.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mqtt": "^5.15.0",
    "socket.io": "^4.8.3"
  }
}
